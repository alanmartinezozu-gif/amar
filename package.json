{
  "name": "speed-to-lead",
  "version": "0.1.0",
  "private": true,
  "description": "Speed-to-lead system for contractors: Facebook/Google/website leads get an AI phone call within seconds, warm-transferred to the owner or booked on the calendar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
