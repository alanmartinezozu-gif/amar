# Copy this file to .env and fill in what you want. Both bots read it.
# Alert bot: everything is optional except that X or pump.fun launches must be on.
# Paper sniper: needs ALERT_WEBHOOK_SECRET and SOLANA_RPC_URL (see the bottom section).
#
# Neither bot has a wallet. They never buy or sell anything.

LOG_LEVEL=info
# Where it remembers what it already alerted on, and writes alerts.jsonl.
DATA_DIR=./data

# ---- Where alerts go (pick one or both) ----
# Telegram: message @BotFather, send /newbot, paste the token here. Then message your new bot
# once and open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server settings > Integrations > Webhooks > New webhook > Copy webhook URL.
DISCORD_WEBHOOK_URL=

# ---- Feed for the paper sniper or your own trading bot (optional) ----
# Every alert is POSTed here as JSON, signed with ALERT_WEBHOOK_SECRET (see README).
# For the paper sniper on the same computer: http://127.0.0.1:8787/alerts
ALERT_WEBHOOK_URL=
# Long random string, at least 16 characters. Your bot uses the same value to check signatures.
ALERT_WEBHOOK_SECRET=

# ---- X (Twitter) ----
# From developer.x.com: create an app, then copy its Bearer Token. X charges per post read, so
# also set a spending limit in the X developer console.
X_BEARER_TOKEN=
# Accounts that announce new coins and whose contract addresses you trust. Comma separated, no @.
X_ACCOUNTS=kimchi1x
# Optional searches for coins announced by anyone. Hits from accounts NOT listed above are marked
# unverified, because impersonators post fake contract addresses.
# url:"pump.fun" matches any post linking to a pump.fun coin. That's thousands a day, so the bot
# reads a sample within the cap below.
X_KEYWORDS=
# The most posts keyword searches may read per UTC day, spread evenly across the day (each check
# reads at most 100). X_ACCOUNTS is never capped. 0 = no cap; otherwise at least 10.
X_KEYWORD_POSTS_PER_DAY=1000
# How often to check X. Each check costs money when there are new posts, so don't go too low.
X_POLL_SECONDS=60
X_MAX_POST_AGE_MINUTES=30

# ---- New coins on pump.fun (free, no key) ----
LAUNCH_ALERTS=true
# Hundreds of coins launch every hour, so you only get individual alerts for ones that match:
# a word in the name or ticker...
LAUNCH_KEYWORDS=
# ...a creator wallet you follow (comma separated)...
LAUNCH_CREATORS=
# ...or a creator who bought at least this much SOL of their own coin. 0 = off.
LAUNCH_BIG_DEV_BUY_SOL=0
# A summary of everything that launched, every N minutes. 0 = off.
LAUNCH_DIGEST_MINUTES=15

# ---- Red-flag checks ----
# A Solana RPC URL turns on checks for mint/freeze authority, sneaky token features and how
# much the top 10 wallets hold. The free public RPC rate-limits hard; a free Helius or
# QuickNode account works much better.
SOLANA_RPC_URL=

# ---- Follow-up price updates ----
# Minutes after each alert to send a price update. Leave empty to turn off.
FOLLOWUP_MINUTES=5,15,60
MAX_TRACKED_COINS=200

# ---- Paper sniper (npm run paper): practice trading with pretend money ----
# It receives the alert bot's alerts on this address (keep 127.0.0.1 unless the bots run on
# different machines). Also needs ALERT_WEBHOOK_SECRET and SOLANA_RPC_URL from above.
PAPER_HOST=127.0.0.1
PAPER_PORT=8787
# Pretend money to start with, and how much each snipe spends.
PAPER_START_SOL=5
PAPER_BUY_SOL=0.5
# Trade "launch" alerts (new pump.fun coins), "x" alerts (coins posted by tracked accounts), or both.
PAPER_SOURCES=launch
PAPER_SKIP_RED_FLAGS=true
# Kimchi bought within 0-2 minutes of creation. Alerts older than this are skipped.
PAPER_MAX_ENTRY_DELAY_SECONDS=120
# Skip coins that already ran past this market cap (launch is about 32 SOL).
PAPER_MAX_ENTRY_MCAP_SOL=60
# His stated rule: take ~50% profit and get out the same day.
PAPER_TAKE_PROFIT_PCT=50
# 100 sells everything at take profit. Lower (e.g. 50) sells part and trails the rest.
PAPER_TAKE_PROFIT_SELL_PCT=100
PAPER_TRAILING_STOP_PCT=30
PAPER_STOP_LOSS_PCT=35
PAPER_MAX_HOLD_MINUTES=30
PAPER_MAX_OPEN_POSITIONS=5
# Quit for the day (UTC) after making / losing this much. 0 = off.
PAPER_DAILY_GOAL_SOL=0
PAPER_MAX_DAILY_LOSS_SOL=0
# Costs a real sniper pays: pump.fun's fee per trade, and priority fee + tip per transaction.
PAPER_FEE_PCT=1.25
PAPER_TX_COST_SOL=0.003
PAPER_DEX_SLIPPAGE_PCT=3
PAPER_PRICE_CHECK_SECONDS=3
# Results summary to Telegram every N minutes. 0 = off.
PAPER_SUMMARY_MINUTES=60
