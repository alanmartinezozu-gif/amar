{
  "name": "memecoin-alerts",
  "version": "0.1.0",
  "private": true,
  "description": "Two cooperating Solana meme-coin bots with no wallet: an alert bot (new coins on X and pump.fun, red-flag checks, follow-ups) and a paper sniper that practice-trades its alerts with pretend money.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "paper": "tsx src/paper/index.ts",
    "example:receiver": "tsx examples/receiver.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
