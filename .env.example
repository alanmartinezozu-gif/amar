# ---- Server ----
PORT=3000
# The public HTTPS address of this server (Twilio, Meta and Google call it). No trailing slash.
PUBLIC_BASE_URL=https://leads.yourdomain.com
# SQLite file. Put it on a persistent volume in production.
DATABASE_PATH=./data/speed-to-lead.db
# Long random string. Encrypts OAuth tokens at rest - don't change it after going live.
APP_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
LOG_LEVEL=info

# ---- Twilio (calls + texts) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Caller ID for contractors that don't have their own number yet.
TWILIO_DEFAULT_NUMBER=+15125550100
# Keep true in production. Set false only for local testing without real Twilio signatures.
TWILIO_VALIDATE_SIGNATURES=true

# ---- Claude (the AI on the phone) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-5-5
# low = fastest replies on the phone. Raise to medium if the AI seems rushed.
ANTHROPIC_EFFORT=low
# "default" retries a declined request on Anthropic's recommended fallback model. "off" disables.
ANTHROPIC_FALLBACKS=default

# ---- Facebook / Instagram lead ads (optional) ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Any string; paste the same value in the Meta app's Webhooks "Verify token" box.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_VERSION=v24.0

# ---- Google Calendar booking (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
