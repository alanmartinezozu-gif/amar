# Copy this file to .env and fill it in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
BRIEF_MODEL=claude-fable-5-2
TRIAGE_MODEL=claude-haiku-5-5
# Cost guard: the most full Fable briefs one run of run_daily.py may write.
MAX_BRIEFS_PER_RUN=10

# --- Scraper identity (shown to the websites we read) ---
CONTACT_EMAIL=you@example.com

# --- Dashboard ---
DASHBOARD_PASSWORD=change-me

# --- Email out (SMTP; for Gmail use an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Phase 1: every report goes ONLY to this address, whatever the client file says.
REPORT_TO=

# --- Optional ---
# BIDDESK_DB=data/biddesk.db
